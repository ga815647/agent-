{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordinary-chat-poc3a",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HANDOFF",
        "class_name": "HandoffStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HandoffStore"]
    }
  ]
}
